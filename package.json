{
  "name": "fastedge",
  "description": "FastEdge GitHub Actions",
  "version": "1.0.3",
  "author": "Gcore",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcore-github-actions/fastedge.git"
  },
  "bugs": {
    "url": "https://github.com/gcore-github-actions/fastedge/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "npm-run-all -s format:write package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action:app": "npx @github/local-action . src/deploy-app/main.ts .env.deploy-app",
    "local-action:secret": "npx @github/local-action ./secrets ../src/secrets/main.ts .env.secrets",
    "package:app": "npx rollup --config rollup-app.config.ts --configPlugin @rollup/plugin-typescript",
    "package:secret": "npx rollup --config rollup-secret.config.ts --configPlugin @rollup/plugin-typescript",
    "package": "npm-run-all -p package:app package:secret",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm-run-all -s format:write lint test coverage package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "qs": "^6.14.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@github/local-action": "^6.0.2",
    "@jest/globals": "^30.0.5",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^17.0.0",
    "jest": "^30.0.5",
    "make-coverage-badge": "^1.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "rollup": "^4.59.0",
    "ts-jest": "^29.4.1",
    "ts-jest-resolver": "^2.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.6",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "flatted": ">=3.4.0",
      "undici@>=7.0.0 <7.24.0": "7.24.0",
      "undici@<6.24.0": "6.24.0",
      "@octokit/plugin-paginate-rest": ">=9.2.2",
      "@octokit/request": ">=8.4.1",
      "lodash": ">=4.17.23",
      "@octokit/request-error": ">=5.1.1",
      "ajv@<6.14.0": "6.14.0"
    }
  }
}
